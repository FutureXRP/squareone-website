# Copy to .env.local for local dev. Set the same values in Vercel > Project > Settings > Environment Variables.

# Interactive app (memberships, room booking, packages, shop). Referenced in copy as {APP}.
NEXT_PUBLIC_INTERACTIVE_APP_URL=https://square-one-interactive.vercel.app

# Public site URL, used for Stripe return URLs and metadata.
NEXT_PUBLIC_SITE_URL=https://squareonecompassion.com

# This site's own Supabase project (form submissions, donations). Server-only, never NEXT_PUBLIC.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Interactive app's Supabase project, read-only anon key under its RLS. Powers "What's on the floor".
INTERACTIVE_SUPABASE_URL=https://INTERACTIVE-PROJECT-REF.supabase.co
INTERACTIVE_SUPABASE_ANON_KEY=interactive-anon-key

# Resend (form notifications, donation receipts). RESEND_FROM must be on a verified domain.
RESEND_API_KEY=re_...
RESEND_FROM=SquareOne Compassion <connect@squareonecompassion.com>

# Stripe Checkout for donations. Leave unset and /give shows the "coming soon" fallback.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
